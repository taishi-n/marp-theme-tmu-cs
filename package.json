{
  "name": "marp-theme-tmu-cs",
  "version": "0.2.1",
  "description": "TMU-CS Marp theme with JS citation processing, step-based code highlighting, math annotations, and external code inclusion.",
  "license": "MIT",
  "type": "module",
  "files": [
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "docs/",
    "engine.mjs",
    "index.mjs",
    "scripts/",
    "src/",
    "theme/",
    "vendor/csl/ieee.csl"
  ],
  "bin": {
    "marp-tmu-cs": "scripts/marp-tmu-cs.mjs",
    "marp-tmu-cs-check": "scripts/check-deck.mjs"
  },
  "exports": {
    ".": "./index.mjs",
    "./engine": "./engine.mjs",
    "./engine.mjs": "./engine.mjs",
    "./theme": "./theme/tmu-cs.css",
    "./theme.css": "./theme/tmu-cs.css",
    "./theme/tmu-cs.css": "./theme/tmu-cs.css",
    "./csl/ieee.csl": "./vendor/csl/ieee.csl"
  },
  "keywords": [
    "marp",
    "marpit",
    "theme",
    "slides",
    "shiki",
    "citation-js",
    "citeproc"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build:html": "cd examples && marp --engine ../engine.mjs slides.md -o dist/slides.html",
    "build:html:standalone": "cd examples && node ../scripts/marp-tmu-cs.mjs --standalone --engine ../engine.mjs slides.md -o dist/slides.standalone.html",
    "build:html:standalone:ci": "node scripts/marp-tmu-cs.mjs --standalone test/fixtures/standalone.md -o examples/dist/ci-standalone.html",
    "build:pdf": "cd examples && marp --allow-local-files --engine ../engine.mjs slides.md -o dist/slides.pdf",
    "build:pptx": "cd examples && marp --allow-local-files --engine ../engine.mjs --pptx --pptx-editable slides.md -o dist/slides.pptx",
    "check": "npm run lint && npm run typecheck && npm test",
    "lint": "eslint .",
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "watch": "cd examples && marp --engine ../engine.mjs --watch slides.md -o dist/slides.html"
  },
  "dependencies": {
    "@citation-js/core": "^0.7.21",
    "@citation-js/plugin-bibtex": "^0.7.21",
    "@citation-js/plugin-csl": "^0.7.22",
    "@marp-team/marp-cli": "4.5.1",
    "@shikijs/transformers": "4.0.2",
    "@xmldom/xmldom": "0.9.11",
    "citeproc": "^2.4.63",
    "js-yaml": "^4.3.1",
    "mathjax-full": "^3.2.2",
    "parse5": "^8.0.1",
    "shiki": "4.0.2",
    "wavegram": "^0.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.0",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "typescript": "^7.0.2"
  }
}
